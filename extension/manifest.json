{
  "manifest_version": 3,
  "name": "ClipDown",
  "version": "1.0.0",
  "description": "Download videos and audio from any page via ClipDown",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "downloads",
    "storage",
    "alarms",
    "nativeMessaging"
  ],
  "host_permissions": [
    "http://localhost:8899/*"
  ],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["utils/media-patterns.js", "content/content-script.js"],
      "run_at": "document_idle"
    }
  ]
}
